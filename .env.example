# Copy to .env at the repo root. docker compose reads it for ports, model files and CPU tuning.

# Postgres exposed on the host
POSTGRES_PORT=5433

# llama.cpp model files inside GGUF_DIR. Lighter quantized files can replace the defaults.
# The embedding model must be the one the corpus was imported with; /health reports CORPUS_NOT_READY otherwise.
# *_MODEL_NAME is the label the backend records in retrieval audit rows.
# GGUF_DIR=./ai-models/gguf
# LLAMA_EMBEDDING_MODEL=qwen3-embedding-4b-fp16.gguf
# LLAMA_EMBEDDING_MODEL_NAME=qwen3-embedding:4b-fp16
# LLAMA_RERANKER_MODEL=qwen3-reranker-4b-f16.gguf
# LLAMA_RERANKER_MODEL_NAME=qwen3-reranker:4b-fp16
# LLAMA_RERANKER_PROTOCOL=completion_logprobs

# CPU tuning (defaults target an i5-13420H: 4 performance + 4 efficiency cores, 12 threads)
# LLAMA_EMBEDDING_THREADS=4
# LLAMA_RERANKER_THREADS=8
# LLAMA_RERANKER_PARALLEL=1
# LLAMA_RERANKER_UBATCH_SIZE=512
# RERANK_MAX_CANDIDATES=15

# Ports
# LLAMA_EMBEDDING_PORT=11434
# LLAMA_RERANKER_PORT=11435
# QDRANT_HTTP_PORT=6333
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# WEB_PORT=8080

# Backend session cookies are Secure by default. Browsers accept that on http://localhost only;
# set false when opening the stack over plain HTTP from another host name.
# COOKIE_SECURE=true
