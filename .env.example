# Port on the host machine where Ollama API is exposed
OLLAMA_PORT=11434

# Port on the host machine where Postgres is exposed
POSTGRES_PORT=5433
KAGGLE_API_TOKEN=your_kaggle_api_token_here
KAGGLE_USERNAME=your_kaggle_username_here

# Path on the host machine for persistent model storage
OLLAMA_DIR=/path/to/your/ai-models
