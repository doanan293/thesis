# Shared ignore rules for every project in this repository.
# A project's own .gitignore lists only output specific to that project.

# Operating systems
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*~

# Local environment and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/

# Python tool caches and coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyrefly/
.coverage
htmlcov/

# Node
node_modules/

# Logs and temporary files
*.log
*.tmp
*.bak

# Local model files
ai-models/

# Local agent tooling
.superpowers/
.worktrees/
