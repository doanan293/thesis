# Copy this file to .env for local runtime configuration.
# The pipeline loads .env only; this file is an instructional template.

# Port on the host machine where Postgres is exposed
POSTGRES_PORT=5433
# Kaggle account profiles. Add more numbered profiles as needed.
KAGGLE_ACCOUNT_DEFAULT=acc1
KAGGLE_SHARED_OWNER=your_primary_kaggle_username_here
KAGGLE_ACC1_USERNAME=your_primary_kaggle_username_here
KAGGLE_ACC1_API_TOKEN=your_acc1_api_token_here
KAGGLE_ACC2_USERNAME=your_secondary_kaggle_username_here
KAGGLE_ACC2_API_TOKEN=your_acc2_api_token_here
