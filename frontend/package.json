{
  "name": "pharma-agent-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "e2e": "playwright test",
    "api:openapi": "uv run --directory ../backend pharma-agent export-openapi --output ../frontend/openapi.json",
    "api:generate": "orval",
    "api:check": "orval && git diff --exit-code -- app/api/gen && test -z \"$(git ls-files --others --exclude-standard -- app/api/gen)\""
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.102",
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "@shadcn/react": "0.3.1",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@tanstack/react-query": "5.102.8",
    "ai": "7.0.99",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "cookie": "2.0.1",
    "i18next": "26.4.2",
    "isbot": "5.2.2",
    "katex": "0.16.47",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-i18next": "17.0.13",
    "react-intersection-observer": "11.0.1",
    "react-router": "8.3.1",
    "remix-i18next": "8.0.0",
    "remix-themes": "2.0.4",
    "shadcn": "4.21.0",
    "streamdown": "2.6.0",
    "tw-animate-css": "1.4.0",
    "tw-shimmer": "0.4.13",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.3.1",
    "@shadcn/helpers": "0.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.0",
    "http-proxy-3": "2.0.1",
    "msw": "2.15.0",
    "orval": "8.32.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "vitest-browser-react": "2.3.0",
    "vitest-fail-on-console": "0.10.1"
  }
}
