# Shared rules (Python caches, virtualenvs, .env, logs, editors) live in the repository root .gitignore.

# Temporary runtime directories
tmp/
temp/

# Local database and vector runtime state
.qdrant/
.clickhouse/
*.vector-cache.lock

# Kaggle local state and job workspaces
.kaggle/
seed-pipeline-kaggle-*/

# Large or generated data lives in the Kaggle archive (`seed data push` / `seed data pull`).
data/sources/**/*.pdf
data/sources/leaflets/html/
data/corpus/**
!data/corpus/**/
!data/corpus/**/manifest.json
!data/corpus/**/validation_report.json
data/evaluation/gold/
data/evaluation/runs/**
!data/evaluation/runs/**/
!data/evaluation/runs/**/run.json
!data/evaluation/runs/**/manifest.json
!data/evaluation/runs/**/report.md
data/cache/
data/work/
